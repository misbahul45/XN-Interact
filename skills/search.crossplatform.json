{
  "id": "search.crossplatform",
  "version": "1.0.0",
  "operations": [
    "search.content"
  ],
  "execution": "direct",
  "workflow": null,
  "risk": "READ",
  "approval": "none",
  "targets": "explicit_account_ids",
