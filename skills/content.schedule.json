{
  "id": "content.schedule",
  "version": "1.0.0",
  "operations": [
    "content.publish.text",
    "content.publish.image",
    "content.publish.video",
    "media.upload"
  ],
  "execution": "workflow",
  "workflow": "content.schedule@1",
  "risk": "EXTERNAL_WRITE",
  "approval": "trusted_user_plan_hash",
  "targets": "explicit_account_ids",
  "failure_policy": "per_target_partial_success",
  "compensate": "none",
  "output_profile": "compact",
  "input": {
    "account_ids": {
      "type": "string[]",
      "required": true,
      "max_items": 20
    },
    "draft_id": {
      "type": "string",
      "required": true
    },
    "schedule_at": {
      "type": "datetime",
      "required": true
    },
    "native": {
      "type": "object"
    }
  }
}
