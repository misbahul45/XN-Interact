{
  "id": "content.publish.media",
  "version": "1.0.0",
  "operations": [
    "media.upload",
    "content.publish.image",
    "content.publish.video"
  ],
  "execution": "workflow",
  "workflow": "content.media_publish@1",
  "risk": "EXTERNAL_WRITE",
  "approval": "trusted_user_plan_hash",
  "targets": "explicit_account_ids",
  "failure_policy": "stop",
  "compensate": "none",
  "output_profile": "compact",
  "input": {
    "account_ids": {
      "type": "string[]",
      "required": true,
      "max_items": 1
    },
    "draft_id": {
      "type": "string",
      "required": true
    },
    "native": {
      "type": "object"
    }
  }
}
